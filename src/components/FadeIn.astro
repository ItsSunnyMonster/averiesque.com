---

<div class="fade-in">
  <slot />
</div>

<style lang="scss" is:global>
  .fade-in > *,
  .fade-in::before,
  .fade-in::after {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeIn 500ms cubic-bezier(0.14, 0.64, 0.46, 1) forwards;
  }

  @for $i from 1 through 25 {
    .fade-in > :nth-child(#{$i}) {
      animation-delay: calc($i * 0.1s);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0px);
    }
  }
</style>
