---
// In this file, any mention of 'cursor' refers to the blob,
// and any mention of 'pointer' refers to the actual mouse pointer of the user.
---

<div id="cursor">
  <svg version="1.1" xmlns="http://www.w3.org/2000/svg">
    <rect rx="12" ry="12" x="0" y="0"></rect>
  </svg>
</div>

<style lang="scss">
  #cursor {
    display: none;
  }

  #cursor.active {
    display: block;
    position: fixed;
    top: -12px;
    left: -12px;

    --width: 24px;
    --height: 24px;
    width: var(--width);
    height: var(--height);

    z-index: 9999;

    pointer-events: none;

    mix-blend-mode: difference;

    --fill: var(--unenergized-accent);
    --radius: 12px;

    will-change: transform;
  }

  #cursor.active > svg {
    > rect {
      fill: var(--fill);
      width: var(--width);
      height: var(--height);
      rx: var(--radius);
      ry: var(--radius);
      transition: fill 300ms ease-in-out;
    }
  }
</style>

<script>
  import {
    lerp,
    distance,
    distanceFromRect,
    inverseFalloff,
  } from "../scripts/utils";
  import { PropProber } from "../scripts/utils/propertyProber";
  import { type SpringSimParams, Spring } from "../scripts/utils/springSim";

  interface CursorParams {
    x: number;
    y: number;
    width: number;
    height: number;
    squish: number;
    angle: number;
    radius: number;
    offsetX: number;
    offsetY: number;
  }

  interface SpringElementProps {
    hovered: boolean;
    x: Spring;
    y: Spring;
  }

  const propProber = new PropProber();

  // Real position of mouse pointer
  let pointerX = 0;
  let pointerY = 0;

  let cursorParams: CursorParams = {
    x: 0,
    y: 0,
    width: 24,
    height: 24,
    squish: 1,
    angle: 0,
    radius: 12,
    offsetX: 0,
    offsetY: 0,
  };

  const elementSpringSimParams: SpringSimParams = {
    stiffness: 500,
    damping: 5,
    mass: 0.5,
  };

  // Higher means more movement per frame
  const pointerAttractionFactor = 10;
  const maximumSquish = 2;
  const squishStrengthFalloff = 0.008;

  const hoverAttractionFalloff = 0.008;
  const maxAttractionDistancePerFontSize = 0.7;

  const interactablesSelector = ".prose a, a.prose, [data-interactable]";

  // To calculate delta time
  let previousTimestamp = 0;

  let hoveredElement: HTMLElement | null = null;
  let hoveredHitbox: HTMLDivElement | null = null;

  let springingElements: Map<HTMLElement, SpringElementProps> = new Map();

  function elementHover(el: HTMLElement) {
    elementUnhover();

    hoveredElement = el;

    if (!springingElements.has(hoveredElement)) {
      springingElements.set(hoveredElement, {
        hovered: true,
        x: new Spring(elementSpringSimParams, 0),
        y: new Spring(elementSpringSimParams, 0),
      });
    } else {
      springingElements.get(hoveredElement)!.hovered = true;
    }

    hoveredHitbox = document.createElement("div");
    Object.assign(hoveredHitbox.style, {
      position: "absolute",
      inset: "0",
      zIndex: "10",
      willChange: "transform",
    });

    el.appendChild(hoveredHitbox);

    el.setAttribute("data-hovered", "");
  }

  function elementUnhover() {
    if (hoveredElement) {
      springingElements.get(hoveredElement)!.x.setTarget(0);
      springingElements.get(hoveredElement)!.y.setTarget(0);
      springingElements.get(hoveredElement)!.hovered = false;
    }
    hoveredElement?.removeAttribute("data-hovered");
    hoveredElement = null;
    hoveredHitbox?.remove();
    hoveredHitbox = null;
  }

  function main() {
    if (window.matchMedia("(prefers-reduced-motion)").matches) return;
    if (!window.matchMedia("(pointer: fine)").matches) return;

    const cursor = document.getElementById("cursor")!;
    const interactables = document.querySelectorAll(interactablesSelector);

    interactables.forEach((el) => {
      let element = el as HTMLAnchorElement;
      element.addEventListener("mouseenter", () => {
        elementHover(element);
      });
    });

    cursor.classList.add("active");
    document.body.classList.add("has-custom-cursor");

    // Update real pointer location
    window.addEventListener("mousemove", (e) => {
      pointerX = e.clientX;
      pointerY = e.clientY;
    });

    // Runs per frame
    function updateCursorStyles(timestamp: number) {
      cursor.style.setProperty(
        "--fill",
        hoveredElement
          ? "var(--energized-accent)"
          : "var(--unenergized-accent)",
      );

      // Calculate deltaTime
      let deltaTimeTemp = (timestamp - previousTimestamp) / 1000;
      const deltaTime = deltaTimeTemp > 1 / 20 ? 0 : deltaTimeTemp;
      previousTimestamp = timestamp;

      if (hoveredElement) {
        // Check if the pointer is now hovering something else
        hoveredHitbox!.style.pointerEvents = "none";
        const hovered = document.elementFromPoint(pointerX, pointerY);
        if (
          hovered !== hoveredElement &&
          hovered?.matches(interactablesSelector)
        ) {
          elementHover(hovered as HTMLElement);
          // Rerun in the same frame
          previousTimestamp -= deltaTime;
          updateCursorStyles(timestamp);
          return;
        }
        hoveredHitbox!.style.pointerEvents = "auto";

        // Get distance of the pointer away from the rect of the interactable element
        const boundingBox = hoveredElement.getBoundingClientRect();
        const distance = distanceFromRect(pointerX, pointerY, boundingBox);

        // Calculate maximum distance of the 'element magnet' from font size
        const elementStyle = window.getComputedStyle(hoveredElement, null);
        const fontSize = parseFloat(
          elementStyle.getPropertyValue("font-size")!.toString(),
        );
        const maxDistance = fontSize * 6;

        // If distance longer than max distance, unhover
        if (distance > maxDistance) {
          elementUnhover();
          // Rerun this in the same frame
          previousTimestamp -= deltaTime;
          updateCursorStyles(timestamp);
          return;
        }

        // Move the hitbox right under the pointer so that it still registers as hovering the element
        hoveredHitbox!.style.transform = `translate3d(calc(${pointerX - boundingBox.left}px - 50%), calc(${pointerY - boundingBox.top}px - 50%), 0)`;

        // Set default paddings if not present
        if (!hoveredElement.style.getPropertyValue("--hover-px"))
          hoveredElement.style.setProperty("--hover-px", "0.5em");
        if (!hoveredElement.style.getPropertyValue("--hover-py"))
          hoveredElement.style.setProperty("--hover-py", "0.25em");

        // Get padding from CSS property
        const paddingX = propProber.propertyToPx(hoveredElement, "--hover-px");
        const paddingY = propProber.propertyToPx(hoveredElement, "--hover-py");

        // Top left corner
        const linkX = boundingBox.x + 12 - paddingX;
        const linkY = boundingBox.y + 12 - paddingY;

        // Falloff offset based on font size and cursor distance
        cursorParams.offsetX =
          maxAttractionDistancePerFontSize *
          fontSize *
          inverseFalloff(
            hoverAttractionFalloff,
            pointerX - linkX - boundingBox.width / 2,
          );
        cursorParams.offsetY =
          maxAttractionDistancePerFontSize *
          fontSize *
          inverseFalloff(
            hoverAttractionFalloff,
            pointerY - linkY - boundingBox.height / 2,
          );

        const targetX = linkX + cursorParams.offsetX;
        const targetY = linkY + cursorParams.offsetY;
        // const targetX = linkX;
        // const targetY = linkY;

        springingElements
          .get(hoveredElement)!
          .x.setTarget(cursorParams.offsetX / 1.7);
        springingElements
          .get(hoveredElement)!
          .y.setTarget(cursorParams.offsetY / 1.7);

        // Don't animate more if the initial growth animation is finished.
        if (
          Math.abs(boundingBox.width + paddingX * 2 - cursorParams.width) <
          0.001
        ) {
          cursorParams.x = targetX;
          cursorParams.y = targetY;
          cursorParams.width = boundingBox.width + paddingX * 2;
          cursorParams.height = boundingBox.height + paddingY * 2;
          cursorParams.radius = 6;
        } else {
          // Animate smoothly to link position
          cursorParams.x = lerp(
            cursorParams.x,
            targetX,
            pointerAttractionFactor * deltaTime * 1.3,
          );
          cursorParams.y = lerp(
            cursorParams.y,
            targetY,
            pointerAttractionFactor * deltaTime * 1.3,
          );

          cursorParams.width = lerp(
            cursorParams.width,
            boundingBox.width + paddingX * 2,
            pointerAttractionFactor * deltaTime * 1.3,
          );
          cursorParams.height = lerp(
            cursorParams.height,
            boundingBox.height + paddingY * 2,
            pointerAttractionFactor * deltaTime * 1.3,
          );
          cursorParams.radius = lerp(
            cursorParams.radius,
            6,
            pointerAttractionFactor * deltaTime * 1.3,
          );
        }

        cursorParams.angle = 0;
        cursorParams.squish = 1;
      } else {
        // Animate smoothly to pointer position
        cursorParams.x = lerp(
          cursorParams.x,
          pointerX,
          pointerAttractionFactor * deltaTime,
        );
        cursorParams.y = lerp(
          cursorParams.y,
          pointerY,
          pointerAttractionFactor * deltaTime,
        );

        // Animate rect shrinking first, before starting to animate circle squishing
        // This is because the angle changing while cursor is still in rect form is very ugly
        if (cursorParams.width - 24 > 0.001) {
          cursorParams.width = lerp(
            cursorParams.width,
            24,
            pointerAttractionFactor * deltaTime * 1.3,
          );
          cursorParams.height = lerp(
            cursorParams.height,
            24,
            pointerAttractionFactor * deltaTime * 1.3,
          );
          cursorParams.radius = lerp(
            cursorParams.radius,
            12,
            pointerAttractionFactor * deltaTime * 1.3,
          );
        } else {
          cursorParams.width = 24;
          cursorParams.height = 24;
          cursorParams.radius = 12;

          const mouseDistance = distance(
            cursorParams.x,
            cursorParams.y,
            pointerX,
            pointerY,
          );

          cursorParams.angle =
            mouseDistance < 0.001
              ? 0
              : Math.atan2(
                  pointerY - cursorParams.y,
                  pointerX - cursorParams.x,
                );

          cursorParams.squish =
            mouseDistance < 0.001
              ? 1
              : 1 +
                (maximumSquish - 1) *
                  inverseFalloff(squishStrengthFalloff, mouseDistance);
        }
      }

      // Update all elements
      springingElements.forEach((p, l) => {
        let x = p.x.step(deltaTime);
        let y = p.y.step(deltaTime);

        l.style.transform = `translate3d(${x}px, ${y}px, 0)`;

        if (!p.hovered && p.x.isSettled() && p.y.isSettled()) {
          springingElements.delete(l);
          l.style.transform = ``;
        }
      });

      // Update rendered position of cursor
      cursor.style.transform = `translate3d(${cursorParams.x}px, ${cursorParams.y}px, 0) rotate(${cursorParams.angle}rad) scale(${cursorParams.squish}, ${1 / cursorParams.squish})`;
      cursor.style.setProperty("--width", `${cursorParams.width}px`);
      cursor.style.setProperty("--height", `${cursorParams.height}px`);
      cursor.style.setProperty("--radius", `${cursorParams.radius}px`);

      requestAnimationFrame(updateCursorStyles);
    }

    // Start the first frame
    requestAnimationFrame(updateCursorStyles);
  }

  main();
</script>
