<div id="cursor">
  <svg version="1.1" xmlns="http://www.w3.org/2000/svg">
    <rect rx="12" ry="12" x="0" y="0"></rect>
  </svg>
</div>

<style lang="scss">
  #cursor {
    display: none;
  }

  #cursor.active {
    display: block;
    position: fixed;
    top: -12px;
    left: -12px;

    --width: 24px;
    --height: 24px;
    width: var(--width);
    height: var(--height);

    z-index: 9999;

    pointer-events: none;

    mix-blend-mode: difference;

    --fill: var(--unenergized-accent);
    --radius: 12px;

    will-change: transform;
  }

  #cursor.active > svg {
    > rect {
      fill: var(--fill);
      width: var(--width);
      height: var(--height);
      rx: var(--radius);
      ry: var(--radius);
      transition: fill 300ms ease-in-out;
    }
  }
</style>

<script>
  import { lerp, distance, distanceFromRect } from "../scripts/utils";
  import { PropertyProber } from "../scripts/utils/propertyProber";

  interface CursorBlobParams {
    x: number;
    y: number;
    width: number;
    height: number;
    squish: number;
    angle: number;
    radius: number;
    offsetX: number;
    offsetY: number;
  }

  interface LinkSpringParams {
    stiffness: number;
    damping: number;
    mass: number;
  }

  interface SpringingLinksProperties {
    velocity: [number, number];
    hovered: boolean;
    translation: [number, number];
    targetTranslation: [number, number];
  }

  const propProber = new PropertyProber();

  // Real position of mouse pointer
  let cursorTargetX = 0;
  let cursorTargetY = 0;

  let cursorBlobParams: CursorBlobParams = {
    x: 0,
    y: 0,
    width: 24,
    height: 24,
    squish: 1,
    angle: 0,
    radius: 12,
    offsetX: 0,
    offsetY: 0,
  };

  const linkSpringParams: LinkSpringParams = {
    stiffness: 500,
    damping: 5,
    mass: 0.5,
  };

  const attractionFactor = 10;
  const maximumSquish = 2;
  const squishStrengthFalloff = 0.008;

  const hoverAttractionFalloff = 0.008;
  const maxAttractionDistancePerFontSize = 0.7;

  const interactablesSelector = ".prose a, a.prose, [data-interactable]";

  // To calculate delta time
  let previousTimestamp = 0;

  let hoveredElement: HTMLElement | null = null;
  let hoveredHitbox: HTMLDivElement | null = null;

  let springingElements: Map<HTMLElement, SpringingLinksProperties> = new Map();

  function springStep(
    current: number,
    target: number,
    dt: number,
    velocity: number,
  ) {
    const force = -linkSpringParams.stiffness * (current - target);
    const dampingForce = -linkSpringParams.damping * velocity;
    const acceleration = (force + dampingForce) / linkSpringParams.mass;
    velocity += acceleration * dt;
    current += velocity * dt;
    return [current, velocity] as const;
  }

  function elementHover(link: HTMLElement) {
    elementUnhover();

    hoveredElement = link;

    if (!springingElements.has(hoveredElement)) {
      springingElements.set(hoveredElement, {
        velocity: [0, 0],
        hovered: true,
        translation: [0, 0],
        targetTranslation: [0, 0],
      });
    } else {
      springingElements.get(hoveredElement)!.hovered = true;
    }

    hoveredHitbox = document.createElement("div");
    Object.assign(hoveredHitbox.style, {
      position: "absolute",
      inset: "0",
      zIndex: "10",
      willChange: "transform",
    });

    link.appendChild(hoveredHitbox);

    link.setAttribute("data-hovered", "");
  }

  function elementUnhover() {
    if (hoveredElement) {
      springingElements.get(hoveredElement)!.targetTranslation = [0, 0];
      springingElements.get(hoveredElement)!.hovered = false;
    }
    hoveredElement?.removeAttribute("data-hovered");
    hoveredElement = null;
    hoveredHitbox?.remove();
    hoveredHitbox = null;
  }

  function inverseFalloff(k: number, x: number) {
    return x >= 0 ? -Math.expm1(-k * x) : Math.expm1(k * x);
  }

  function main() {
    if (window.matchMedia("(prefers-reduced-motion)").matches) return;
    if (!window.matchMedia("(pointer: fine)").matches) return;

    const cursor = document.getElementById("cursor")!;
    const proseLinks = document.querySelectorAll(interactablesSelector);

    proseLinks.forEach((l) => {
      let link = l as HTMLAnchorElement;
      link.addEventListener("mouseenter", () => {
        elementHover(link);
      });
    });

    cursor.classList.add("active");
    document.body.classList.add("has-custom-cursor");

    // Update real pointer location
    window.addEventListener("mousemove", (e) => {
      cursorTargetX = e.clientX;
      cursorTargetY = e.clientY;
    });

    // Runs per frame
    function updateCursorStyles(timestamp: number) {
      cursor.style.setProperty(
        "--fill",
        hoveredElement
          ? "var(--energized-accent)"
          : "var(--unenergized-accent)",
      );

      // Calculate deltaTime
      let deltaTimeTemp = (timestamp - previousTimestamp) / 1000;
      const deltaTime = deltaTimeTemp > 1 / 20 ? 0 : deltaTimeTemp;
      previousTimestamp = timestamp;

      if (hoveredElement) {
        // Check if the pointer is now hovering something else
        hoveredHitbox!.style.pointerEvents = "none";
        const hovered = document.elementFromPoint(cursorTargetX, cursorTargetY);
        if (
          hovered !== hoveredElement &&
          hovered?.matches(interactablesSelector)
        ) {
          elementHover(hovered as HTMLElement);
          // Rerun in the same frame
          previousTimestamp -= deltaTime;
          updateCursorStyles(timestamp);
          return;
        }

        hoveredHitbox!.style.pointerEvents = "auto";

        // Get distance of the pointer away from the rect of the link
        const boundingBox = hoveredElement.getBoundingClientRect();
        const distance = distanceFromRect(
          cursorTargetX,
          cursorTargetY,
          boundingBox,
        );

        // Calculate maximum distance of the 'link magnet' from font size
        const linkStyle = window.getComputedStyle(hoveredElement, null);
        const fontSize = parseFloat(
          linkStyle.getPropertyValue("font-size")!.toString(),
        );
        const maxDistance = fontSize * 6;

        // If distance longer than max distance, unhover
        if (distance > maxDistance) {
          elementUnhover();
          // Rerun this in the same frame
          previousTimestamp -= deltaTime;
          updateCursorStyles(timestamp);
          return;
        }

        // Move the hitbox right under the pointer so that it still registers as hovering the link
        hoveredHitbox!.style.transform = `translate3d(calc(${cursorTargetX - boundingBox.left}px - 50%), calc(${cursorTargetY - boundingBox.top}px - 50%), 0)`;

        // Set default paddings if not present
        if (!hoveredElement.style.getPropertyValue("--hover-px"))
          hoveredElement.style.setProperty("--hover-px", "0.5em");
        if (!hoveredElement.style.getPropertyValue("--hover-py"))
          hoveredElement.style.setProperty("--hover-py", "0.25em");
        const paddingX = propProber.propertyToPx(hoveredElement, "--hover-px");
        const paddingY = propProber.propertyToPx(hoveredElement, "--hover-py");
        console.log(paddingX, paddingY);

        // Top left corner
        const linkX = boundingBox.x + 12 - paddingX;
        const linkY = boundingBox.y + 12 - paddingY;

        // Falloff offset based on font size and cursor distance
        cursorBlobParams.offsetX =
          maxAttractionDistancePerFontSize *
          fontSize *
          inverseFalloff(
            hoverAttractionFalloff,
            cursorTargetX - linkX - boundingBox.width / 2,
          );
        cursorBlobParams.offsetY =
          maxAttractionDistancePerFontSize *
          fontSize *
          inverseFalloff(
            hoverAttractionFalloff,
            cursorTargetY - linkY - boundingBox.height / 2,
          );

        const targetX = linkX + cursorBlobParams.offsetX;
        const targetY = linkY + cursorBlobParams.offsetY;
        // const targetX = linkX;
        // const targetY = linkY;

        springingElements.get(hoveredElement)!.targetTranslation = [
          cursorBlobParams.offsetX / 1.7,
          cursorBlobParams.offsetY / 1.7,
        ];

        // Don't animate more if the initial growth animation is finished.
        if (
          Math.abs(boundingBox.width + paddingX * 2 - cursorBlobParams.width) <
          0.001
        ) {
          cursorBlobParams.x = targetX;
          cursorBlobParams.y = targetY;
          cursorBlobParams.width = boundingBox.width + paddingX * 2;
          cursorBlobParams.height = boundingBox.height + paddingY * 2;
          cursorBlobParams.radius = 6;
        } else {
          // Animate smoothly to link position
          cursorBlobParams.x = lerp(
            cursorBlobParams.x,
            targetX,
            attractionFactor * deltaTime * 1.3,
          );
          cursorBlobParams.y = lerp(
            cursorBlobParams.y,
            targetY,
            attractionFactor * deltaTime * 1.3,
          );

          cursorBlobParams.width = lerp(
            cursorBlobParams.width,
            boundingBox.width + paddingX * 2,
            attractionFactor * deltaTime * 1.3,
          );
          cursorBlobParams.height = lerp(
            cursorBlobParams.height,
            boundingBox.height + paddingY * 2,
            attractionFactor * deltaTime * 1.3,
          );
          cursorBlobParams.radius = lerp(
            cursorBlobParams.radius,
            6,
            attractionFactor * deltaTime * 1.3,
          );
        }

        cursorBlobParams.angle = 0;
        cursorBlobParams.squish = 1;
      } else {
        // Animate smoothly to pointer position
        cursorBlobParams.x = lerp(
          cursorBlobParams.x,
          cursorTargetX,
          attractionFactor * deltaTime,
        );
        cursorBlobParams.y = lerp(
          cursorBlobParams.y,
          cursorTargetY,
          attractionFactor * deltaTime,
        );

        // Animate rect shrinking first, before starting to animate circle squishing
        // This is because the angle changing while cursor is still in rect form is very ugly
        if (cursorBlobParams.width - 24 > 0.001) {
          cursorBlobParams.width = lerp(
            cursorBlobParams.width,
            24,
            attractionFactor * deltaTime * 1.3,
          );
          cursorBlobParams.height = lerp(
            cursorBlobParams.height,
            24,
            attractionFactor * deltaTime * 1.3,
          );
          cursorBlobParams.radius = lerp(
            cursorBlobParams.radius,
            12,
            attractionFactor * deltaTime * 1.3,
          );
        } else {
          cursorBlobParams.width = 24;
          cursorBlobParams.height = 24;
          cursorBlobParams.radius = 12;

          const mouseDistance = distance(
            cursorBlobParams.x,
            cursorBlobParams.y,
            cursorTargetX,
            cursorTargetY,
          );

          cursorBlobParams.angle =
            mouseDistance < 0.001
              ? 0
              : Math.atan2(
                  cursorTargetY - cursorBlobParams.y,
                  cursorTargetX - cursorBlobParams.x,
                );

          cursorBlobParams.squish =
            mouseDistance < 0.001
              ? 1
              : 1 +
                (maximumSquish - 1) *
                  inverseFalloff(squishStrengthFalloff, mouseDistance);
        }
      }

      // Update all links
      springingElements.forEach((p, l) => {
        [p.translation[0], p.velocity[0]] = springStep(
          p.translation[0],
          p.targetTranslation[0],
          deltaTime,
          p.velocity[0],
        );
        [p.translation[1], p.velocity[1]] = springStep(
          p.translation[1],
          p.targetTranslation[1],
          deltaTime,
          p.velocity[1],
        );

        l.style.transform = `translate3d(${p.translation[0]}px, ${p.translation[1]}px, 0)`;

        const settled =
          Math.abs(p.translation[0] - p.targetTranslation[0]) < 0.001 &&
          Math.abs(p.translation[1] - p.targetTranslation[1]) < 0.001 &&
          Math.abs(p.velocity[0]) < 0.001 &&
          Math.abs(p.velocity[1]) < 0.001;

        if (!p.hovered && settled) {
          springingElements.delete(l);
          l.style.transform = ``;
        }
      });

      // Update rendered position of cursor
      cursor.style.transform = `translate3d(${cursorBlobParams.x}px, ${cursorBlobParams.y}px, 0) rotate(${cursorBlobParams.angle}rad) scale(${cursorBlobParams.squish}, ${1 / cursorBlobParams.squish})`;
      cursor.style.setProperty("--width", `${cursorBlobParams.width}px`);
      cursor.style.setProperty("--height", `${cursorBlobParams.height}px`);
      cursor.style.setProperty("--radius", `${cursorBlobParams.radius}px`);

      requestAnimationFrame(updateCursorStyles);
    }

    // Start the first frame
    requestAnimationFrame(updateCursorStyles);
  }

  main();
</script>
