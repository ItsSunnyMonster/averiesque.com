---
// import Logo from "./Logo.astro";

import { Icon } from "astro-icon/components";

interface Props {}
---

<header>
  <div class="content-container">
    <div class="left-container">
      <!-- <Logo size={60} /> -->
      <a href="/" class="prose home-link">Avery's website</a>
      <div class="social-links-container">
        <a href="https://github.com/ItsSunnyMonster" data-interactable>
          <Icon name="fa7-brands:github" />
        </a>
        <a href="https://bsky.app/profile/averiesque.com" data-interactable>
          <Icon name="fa7-brands:bluesky" />
        </a>
        <a href="https://youtube.com/@ItsSunnyMonster" data-interactable>
          <Icon name="fa7-brands:youtube" />
        </a>
      </div>
    </div>
    <div class="right-container">
      <a href="#" class="prose">-&gt;blog</a>
      <a href="#" class="prose">-&gt;projects</a>
    </div>
  </div>
</header>

<style lang="scss">
  @use "../styles/mixins/fonts";

  a {
    @include fonts.code;
  }

  header {
    @include fonts.body;

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;

    padding: 1.5rem 2rem;

    display: flex;
    justify-content: center;
    align-items: center;

    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);

    border-bottom: 2px solid #ffffff00;
    background-color: var(--c-mantle);

    z-index: 10;

    &.scrolled {
      background-color: var(--c-crust);
      border-bottom: 2px solid var(--c-subtext0);
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  .home-link {
    @include fonts.header;
    font-size: 2rem;

    color: transparent;
    background-clip: text;
    background-image: linear-gradient(
      to right,
      var(--c-sapphire),
      var(--c-pink),
      var(--c-text),
      var(--c-pink),
      var(--c-sapphire),
      var(--c-red),
      var(--c-red),
      var(--c-mauve),
      var(--c-blue),
      var(--c-blue),
      var(--c-sapphire)
    );
    background-size: 150%;
    animation: gradientScroll 5s linear infinite;

    &::after {
      bottom: 0px;
    }
  }

  :root[data-theme="light"] .home-link {
    background-image: linear-gradient(
      to right,
      var(--c-red),
      var(--c-peach),
      var(--c-yellow),
      var(--c-green),
      var(--c-sapphire),
      var(--c-mauve),
      var(--c-red)
    );
  }

  .content-container {
    max-width: 75ch;
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .left-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    min-height: 60px;
  }

  .social-links-container {
    display: flex;
    gap: 0.5rem;

    > a {
      color: var(--c-text);
      display: flex;
      align-items: center;
      padding: 0.375rem;
      --hover-px: 0px;
      --hover-py: 0px;
    }
  }

  .right-container {
    display: flex;
    gap: 0.75rem;

    > a {
      font-size: 1.25rem;

      &::after {
        bottom: -5px;
      }
    }
  }

  @keyframes gradientScroll {
    0% {
      background-position-x: 0%;
    }

    100% {
      background-position-x: 300%;
    }
  }
</style>

<script>
  const header = document.querySelector("header");

  let rafID: number | null = null;
  let scrolled = false;

  function handleScroll() {
    if (window.scrollY >= 40 != scrolled) {
      if (rafID) cancelAnimationFrame(rafID);

      rafID = requestAnimationFrame(() => {
        scrolled = window.scrollY >= 40;
        if (scrolled) header?.classList.add("scrolled");
        else header?.classList.remove("scrolled");
      });
    }
  }

  window.addEventListener("scroll", handleScroll);
  handleScroll();
</script>
