---
// import Logo from "./Logo.astro";

import { Icon } from "astro-icon/components";

import Hamburger from "./nav/Hamburger.astro";
import ThemeSwitch from "./nav/ThemeSwitch.astro";

interface Props {}
---

<header transition:persist>
  <div class="content-container">
    <div class="left-container">
      <!-- <Logo size={60} /> -->
      <a href="/" class="prose home-link">Avery's website</a>
      <div class="social-links-container">
        <a href="https://github.com/ItsSunnyMonster" data-interactable>
          <Icon name="fa7-brands:github" />
        </a>
        <a href="https://bsky.app/profile/averiesque.com" data-interactable>
          <Icon name="fa7-brands:bluesky" />
        </a>
        <a href="https://youtube.com/@ItsSunnyMonster" data-interactable>
          <Icon name="fa7-brands:youtube" />
        </a>
      </div>
    </div>
    <div class="right-container">
      <div class="menu-container">
        <a href="#" class="prose">-&gt;blog</a>
        <a href="#" class="prose">-&gt;about</a>
        <a href="#" class="prose">-&gt;projects</a>
      </div>
      <div class="separator">|</div>
      <ThemeSwitch />
    </div>
    <div class="narrow-right-container">
      <Hamburger />
    </div>
  </div>
</header>
<div id="header-scroll-sentinel" transition:persist></div>

<style lang="scss">
  @use "../styles/mixins/fonts";
  @use "../styles/mixins/utils" as u;

  a {
    @include fonts.code;
    text-wrap: nowrap;
  }

  header {
    @include fonts.body;

    position: fixed;
    width: 100vw;
    inset-inline: 0;

    padding: 1.5rem 2rem;

    display: flex;
    justify-content: center;
    align-items: center;

    @include u.transitions((background-color, padding, border-color));

    border-bottom: 2px solid #ffffff00;
    background-color: var(--c-mantle);

    z-index: 10;

    &.scrolled {
      background-color: var(--c-crust);
      border-bottom: 2px solid var(--c-subtext0);
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }

    &.bordered {
      border-bottom: 2px solid var(--c-subtext0);
      background-color: var(--c-crust);
    }
  }

  .home-link {
    @include fonts.header;
    font-size: 2rem;

    color: transparent;
    background-clip: text;
    background-image: linear-gradient(
      to right,
      var(--c-sapphire),
      var(--c-pink),
      var(--c-text),
      var(--c-pink),
      var(--c-sapphire),
      var(--c-red),
      var(--c-red),
      var(--c-mauve),
      var(--c-blue),
      var(--c-blue),
      var(--c-sapphire)
    );
    background-size: 150%;
    animation: gradientScroll 5s linear infinite;

    &::after {
      bottom: 0px;
    }
  }

  :root[data-theme="light"] .home-link {
    background-image: linear-gradient(
      to right,
      var(--c-red),
      var(--c-peach),
      var(--c-yellow),
      var(--c-green),
      var(--c-sapphire),
      var(--c-mauve),
      var(--c-red)
    );
  }

  .content-container {
    max-width: 75ch;
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .left-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    min-height: 60px;
  }

  .social-links-container {
    display: flex;
    gap: 0.5rem;

    > a {
      color: var(--c-text);
      display: flex;
      align-items: center;
      padding: 0.375rem;
      --hover-px: 0px;
      --hover-py: 0px;
    }
  }

  .menu-container {
    display: flex;
    gap: 0.75rem;
    > a {
      font-size: 1.25rem;

      &::after {
        bottom: 0px;
      }
    }
  }

  .right-container {
    display: flex;
    gap: 0.75rem;
  }

  .narrow-right-container {
    display: none;
  }

  @keyframes gradientScroll {
    0% {
      background-position-x: 0%;
    }

    100% {
      background-position-x: 300%;
    }
  }

  @media only screen and (max-width: 700px) {
    .narrow-right-container {
      display: flex;
      flex-direction: row-reverse;
      gap: 1rem;
      align-items: center;
    }

    .right-container {
      position: absolute;
      top: 100%;
      right: 0;

      padding: 2rem;

      background-color: var(--c-crust);

      display: flex;
      gap: 0.75rem;

      border-left: 2px solid var(--c-subtext0);
      border-bottom: 2px solid var(--c-subtext0);

      border-bottom-left-radius: 1rem;

      opacity: 0;
      transform: scaleY(0);
      @include u.transitions((opacity, transform));
      transform-origin: top;

      &::after {
        content: "";
        position: absolute;
        background: transparent;
        right: 100%;
        top: 0;
        width: 2rem;
        height: 1rem;
        border-top-right-radius: 1rem;
        border-top: 2px solid var(--c-subtext0);
        border-right: 2px solid var(--c-subtext0);
        box-shadow: 1rem 0 0 0 var(--c-crust);
      }

      &.open {
        opacity: 1;
        transform: scaleY(1);
      }

      & > .separator {
        display: none;
      }

      & a::after {
        bottom: -5px;
      }
    }

    .social-links-container {
      flex-direction: column;

      padding-left: 0.5rem;
      border-left: 2px solid var(--c-surface2);
    }

    .menu-container {
      flex-direction: column;
      align-items: end;
      justify-content: center;
    }
  }
</style>

<script>
  import { scrollObserver } from "../scripts/utils/scrollObserver";

  const header = document.querySelector("header")!;

  scrollObserver.add({
    offset: 40,
    onScrollPast: () => header.classList.add("scrolled"),
    onScrollBack: () => header.classList.remove("scrolled"),
  });
</script>

<script>
  const icons = document.querySelector(".social-links-container")!;
  const wideParent = document.querySelector(".left-container")!;
  const narrowParent = document.querySelector(".right-container")!;

  const mq = window.matchMedia("(max-width: 700px)");

  function placeIcons(isNarrow: boolean) {
    const target = isNarrow ? narrowParent : wideParent;
    if (icons.parentElement != target) {
      target.appendChild(icons);
    }
  }

  placeIcons(mq.matches);
  mq.addEventListener("change", (e) => placeIcons(e.matches));
</script>

<script>
  const themeSwitch = document.querySelector("#theme-toggle")!;
  const wideParent = document.querySelector(".right-container")!;
  const narrowParent = document.querySelector(".narrow-right-container")!;

  const mq = window.matchMedia("(max-width: 700px)");

  function placeIcons(isNarrow: boolean) {
    const target = isNarrow ? narrowParent : wideParent;
    if (themeSwitch.parentElement != target) {
      target.appendChild(themeSwitch);
    }
  }

  placeIcons(mq.matches);
  mq.addEventListener("change", (e) => placeIcons(e.matches));
</script>
