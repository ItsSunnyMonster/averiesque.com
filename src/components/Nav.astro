---
// import Logo from "./Logo.astro";

interface Props {}
---

<header>
  <div class="content-container">
    <div class="left-container">
      <!-- <Logo size={60} /> -->
      <a href="/" class="prose">Averiesque</a>
    </div>
    <div class="right-container"></div>
  </div>
</header>

<style lang="scss">
  @use "../styles/mixins/fonts";

  a {
    @include fonts.header;
  }

  header {
    @include fonts.body;

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;

    padding: 1.5rem 2rem;

    display: flex;
    justify-content: center;
    align-items: center;

    // transition: all 200ms ease-in-out;

    border-bottom: 2px solid #ffffff00;
    background-color: var(--c-mantle);

    z-index: 10;
  }

  .content-container {
    max-width: 75ch;
    width: 100%;

    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .left-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    min-height: 60px;

    > a {
      font-size: 1.5rem;
      font-weight: 480;
    }
  }
</style>
