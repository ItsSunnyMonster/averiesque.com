<footer>
  <div class="container">
    <div class="text-container">
      <p>made with ❤️ by avery (she/her)</p>
      <p class="line-2">
        © 2026 Avery Lin.
        <span></span>
        <a href="#">license</a>
        <span></span>
        <a href="#">source</a>
        <span></span>
        <a href="./sitemap-index.xml">sitemap</a>
      </p>
    </div>
    <script
      is:inline
      type="text/javascript"
      src="https://storage.ko-fi.com/cdn/widget/Widget_2.js"></script>
    <script is:inline type="text/javascript">
      kofiwidget2.init("Buy me a coffee", "#FF6433", "P5P3WD1QV");
      kofiwidget2.draw();
    </script>
  </div>
