---
import { Icon } from "astro-icon/components";
---

<div class="container" id="back-to-top" transition:persist>
  <button data-interactable>
    <Icon name="at-icons:arrow-up" />
  </button>
</div>

<style lang="scss">
  @use "../styles/mixins/utils" as u;

  #back-to-top-scroll-sentinel {
    position: absolute;
    top: 1000px;
  }

  .container {
    position: fixed;
    z-index: 50;
    right: calc(5rem + (100% - 100vw));
    bottom: 5rem;

    @include u.transitions((transform));

    transform: translateY(200px);
  }

  .container.visible {
    transform: translateY(0px);
  }

  button {
    border: none;
    height: calc(24px + 2 * 0.75rem);

    padding: 0.75rem;
    background-color: var(--c-text);
    border-radius: 9999px;
    cursor: pointer;

    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;

    --hover-px: 0.2rem;
    --hover-py: 0.2rem;
    --hover-radius: 9999px;
  }

  button > [data-icon] {
    width: 24px;
    height: 24px;
    color: var(--c-mantle);
  }
</style>

<script>
  import { scrollObserver } from "../scripts/utils/scrollObserver.ts";

  const button = document.getElementById("back-to-top")!;

  function scroll() {
    window.scrollTo({ top: 0 });
  }

  button.addEventListener("click", scroll);

  scrollObserver.add({
    offset: 1000,
    onScrollPast: () => button.classList.add("visible"),
    onScrollBack: () => button.classList.remove("visible"),
  });
</script>
