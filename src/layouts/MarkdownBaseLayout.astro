---
import type { MarkdownLayoutProps } from "astro";

import type { Props as BaseProps } from "./BaseLayout.astro";
import BaseLayout from "./BaseLayout.astro";
import FadeIn from "../components/FadeIn.astro";

type Props = MarkdownLayoutProps<BaseProps & { hideTitle: boolean }>;

const { title, hideTitle } = Astro.props.frontmatter;
---

<BaseLayout {...Astro.props.frontmatter}>
  <article class="prose">
    <FadeIn>
      {hideTitle ? null : <h1>{title}</h1>}
      <slot />
    </FadeIn>
  </article>
</BaseLayout>
