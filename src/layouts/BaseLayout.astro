---
import Nav from "../components/Nav.astro";

import "../styles/global.scss";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Playpen+Sans:wght@100..800&family=Sour+Gummy:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
  </body>
</html>

<style lang="scss">
  @use "../styles/themes";
  @use "../styles/mixins/fonts";

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    background-color: var(--c-mantle);
    color: var(--c-text);

    position: relative;

    @include fonts.body;

    font-size: clamp(1em, 0.875rem + 0.5vw, 1.25rem);

    display: flex;
    flex-direction: column;
    align-items: center;
    // transition:
    //   background-color 200ms ease-in-out,
    //   color 200ms ease-in-out;
  }

  main {
    max-width: 70ch;
    width: 100%;
    padding: 1.5rem 2rem;
    margin-top: 9rem;
  }
</style>
