---
import Nav from "../components/Nav.astro";

const title = Astro.props?.frontmatter?.title ?? Astro.props.title;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Playpen+Sans:wght@100..800&family=Sour+Gummy:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
  </body>
</html>

<style lang="scss">
  @use "../styles/themes";
  @use "../styles/fonts";

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    background-color: var(--c-mantle);
    color: var(--c-text);

    position: relative;

    @include fonts.body;

    font-size: 1.25rem;
    line-height: 1.75rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    transition:
      background-color 200ms ease-in-out,
      color 200ms ease-in-out;
  }

  main {
    max-width: 64rem;
    width: 100%;
    padding: 1.5rem 2rem;
    margin-top: 9rem;
  }
</style>

<style is:global lang="scss">
  @use "../styles/fonts";

  * {
    box-sizing: border-box;
  }

  h1 {
    @include fonts.header;

    margin-top: 0;
    margin-bottom: 0.857143em;
    font-size: 2.8em;
    line-height: 1;
  }

  a.green {
    color: var(--c-pink);
    text-shadow: 0px 0px 15px var(--c-pink);
    text-decoration: none;
  }

  a.green:hover {
    color: var(--c-mantle);
    text-shadow: none;
    background-color: var(--c-green);
  }
</style>
